<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHỌN ẢNH SẢN PHẨM"
        android:textColor="#2196F3"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="Chọn ảnh từ thư mục assets/anh hoặc từ thiết bị"
        android:textColor="#666666"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvEmptyAssets"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:text="Chưa có ảnh trong thư mục assets/anh"
        android:textColor="#999999"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAssetImages"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnPickFromDevice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#4CAF50"
        android:text="📁 Chọn ảnh từ thiết bị / Bộ sưu tập"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="6dp" />

    <Button
        android:id="@+id/btnEnterImageUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#FF9800"
        android:text="🔗 Dán link ảnh từ mạng (URL)"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="6dp" />

    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#E0E0E0"
        android:text="Đóng"
        android:textColor="#333333"
        android:textSize="14sp"
        app:cornerRadius="6dp" />
</LinearLayout>
